          </mxGeometry>
        </mxCell>
        <mxCell id="BLhZ6JWoXuRRobSCugTl-59" value="쯔모&lt;div&gt;1. 덱에서 패를 하나 뽑는다&lt;/div&gt;&lt;div&gt;2. 나의 템프에 패를 담아둔다&lt;/div&gt;&lt;div&gt;3. 나의 스택 + 템프가 화료할수 있다면 쯔모를 띄운다&lt;/div&gt;&lt;div&gt;4. 리치를 할 수 있다면 리치를 띄운다&lt;/div&gt;" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1127" y="442" width="256" height="114" as="geometry" />
        </mxCell>
        <mxCell id="BLhZ6JWoXuRRobSCugTl-61" value="타패&lt;div&gt;1. 내 덱에 있는 패중 하나를 버린다&lt;/div&gt;&lt;div&gt;2. 버린 스택에 패를 둔다&lt;/div&gt;&lt;div&gt;3. 다른사람이 주워갈 수 있다면 줍는다&lt;/div&gt;" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1153" y="592" width="204" height="128" as="geometry" />
        </mxCell>
